/*
 * Defaults for the ANORAK pipeline. Cluster-specific settings live in
 * conf/beatson.config and are selected with `-profile beatson`; nothing in
 * this file names a partition, a queue or an image path, so the pipeline runs
 * somewhere else without editing it.
 */

manifest {
    name            = 'anorak-nf'
    description     = 'ANORAK growth-pattern segmentation and IASLC grading for lung adenocarcinoma WSIs'
    author          = 'Vaidehi Pandya'
    homePage        = 'https://github.com/xi11/AIgrading'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '0.1.0'
}

// bin/ is put on PATH by Nextflow itself; this only makes the wrappers
// executable requirements explicit for anyone reading the repo.
params {
    outdir       = 'results'
    slide_column = 'slide_id'
    sample_column = 'samples'
    output_mpp   = 0.22
    patch_size   = 768
    patch_stride = 192
    colour_norm  = true
    // Directory of Python packages the inference image lacks, prepended to
    // PYTHONPATH inside the container. Null here because it is a property of
    // the image, and the image is named in conf/beatson.config.
    gpu_extras   = null
    // Images, when a profile runs a step in one. Named here, not only in the
    // profile, because main.nf digests a local image into the tasks' keys
    // (Nextflow keys on the image's name, not its bytes) and must be able to
    // ask for it on every profile.
    gpu_container    = null
    tiling_container = null
    republish    = ''
    allow_missing_slides = false
    tumour_column = 'is_tumour'

    // Ceilings on what a retry may ask for. Requests grow with task.attempt,
    // and one over a partition's limit either is refused at sbatch or pends
    // forever. The second is the worse: Nextflow's task monitor keeps logging
    // while the job pends, so the head job's watchdog (tools/nf_supervise.sh)
    // sees a healthy run and the cohort waits out the head job's walltime.
    // Null means no ceiling. conf/beatson.config sets this cluster's, and
    // tools/preflight.sh checks them against sinfo. Strings, so a CLI
    // --max_gpu_time 2d parses the same as the config; the closures below
    // take min(request, ceiling), and config v2 allows no helper function to
    // say that once.
    max_cpu_memory = null
    max_cpu_time   = null
    max_gpu_memory = null
    max_gpu_time   = null
}

process {
    // Exit 65 is a wrapper's refusal (bin/anorak_common.py, REFUSAL_EXIT_CODE):
    // this slide's input or output is wrong, deterministically, and a retry
    // reads the same bytes. It finishes the run — let the running tasks drain,
    // queue nothing new — because carrying on would carry a hole into the
    // grading table.
    //
    // Everything else is retried, then finishes. The list this replaced
    // retried only kill/OOM signals, and finished on the two failures this
    // cluster actually produces most: Integer.MAX_VALUE, which is Nextflow for
    // "no readable .exitcode" (node failure, preemption, a refused sbatch, or
    // a CephFS read that outlived exitReadTimeout), and 1, which is any
    // uncaught Python exception — a CUDA context that did not come up, an EIO
    // off CephFS, a TensorFlow OOM. A real bug fails maxRetries times and then
    // finishes just the same, for the price of two retries.
    //
    // 'finish' rather than 'terminate' once retries are spent, which is what a
    // bare 'retry' turns into: terminate kills every running task, and at 200
    // in flight that is hours of tiling thrown away for one slide.
    //
    // Override with -process.errorStrategy=ignore for a deliberately
    // best-effort sweep; main.nf then lists the slides that did not make it in
    // anorak_missing_slides.csv instead of refusing a short table.
    errorStrategy = { task.exitStatus == 65 ? 'finish'
                      : task.attempt <= 2 ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_tiling {
        cpus   = 1          // cws_generator tiles single-threaded
        memory = { def r = 16.GB * task.attempt; params.max_cpu_memory ? [r, MemoryUnit.of(params.max_cpu_memory.toString())].min() : r }
        time   = { def r = 8.h * task.attempt; params.max_cpu_time ? [r, Duration.of(params.max_cpu_time.toString())].min() : r }
    }
    withLabel: process_gpu {
        cpus   = 4
        memory = { def r = 32.GB * task.attempt; params.max_gpu_memory ? [r, MemoryUnit.of(params.max_gpu_memory.toString())].min() : r }
        time   = { def r = 12.h * task.attempt; params.max_gpu_time ? [r, Duration.of(params.max_gpu_time.toString())].min() : r }
    }
    withLabel: process_stitch {
        cpus   = 1
        // Stitching allocates the whole slide at Ss1 scale in float, twice.
        memory = { def r = 24.GB * task.attempt; params.max_cpu_memory ? [r, MemoryUnit.of(params.max_cpu_memory.toString())].min() : r }
        time   = { def r = 4.h * task.attempt; params.max_cpu_time ? [r, Duration.of(params.max_cpu_time.toString())].min() : r }
    }
    // Hard links and stats, a few thousand per slide: nothing to compute and
    // nothing to hold, so the smallest request the partition takes.
    withLabel: process_publish {
        cpus   = 1
        memory = { def r = 1.GB * task.attempt; params.max_cpu_memory ? [r, MemoryUnit.of(params.max_cpu_memory.toString())].min() : r }
        time   = { def r = 30.m * task.attempt; params.max_cpu_time ? [r, Duration.of(params.max_cpu_time.toString())].min() : r }
    }
    withLabel: process_light {
        cpus   = 1
        memory = { def r = 8.GB * task.attempt; params.max_cpu_memory ? [r, MemoryUnit.of(params.max_cpu_memory.toString())].min() : r }
        time   = { def r = 1.h * task.attempt; params.max_cpu_time ? [r, Duration.of(params.max_cpu_time.toString())].min() : r }
    }
}

profiles {
    standard { process.executor = 'local' }
    beatson  { includeConfig 'conf/beatson.config' }
    // Resource requests dropped to nothing: a stub run does no work, and the
    // real ones exceed what a laptop advertises, so the local executor would
    // refuse to schedule them before any logic was exercised.
    stub {
        process {
            executor = 'local'
            // A regex selector, because the per-label requests in the base
            // config outrank a bare process.memory and would still be applied.
            withLabel: 'process_.*' { cpus = 1; memory = 1.GB; time = 10.m }
        }
    }
}

// Provenance, free. These are what make a run answerable months later.
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";     overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html";      overwrite = true }
