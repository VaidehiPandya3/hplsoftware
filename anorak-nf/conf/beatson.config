/*
 * Beatson HPC. Everything cluster-specific is here, so main.nf and
 * nextflow.config name no partition, queue or image and run elsewhere unedited.
 *
 * GPU type names are exact and cluster-specific — a constraint naming a type
 * this cluster does not have is inert rather than approximate, and the job
 * then queues forever against the first type instead of falling back. Check
 * what actually exists with:
 *     sinfo -p gpu -o "%N %G %t %D"
 *
 * gpu_type is deliberately unset, which asks for --gres=gpu:1 and takes any
 * card on the partition. As of 2026-09 that is 25 GPUs across five nodes —
 * 16 H200, 4 H100 HBM3, 3 H100 PCIe, 2 A100 — and naming one type would have
 * restricted the whole cohort to whichever slice that is. Which is the wrong
 * trade here: this run is throughput-bound across thousands of independent
 * slides, so how many segment at once matters and how fast any one of them
 * goes does not. Set it only to exclude a card that cannot do the work.
 */

params {
    gpu_partition = 'gpu'
    cpu_partition = 'compute'
    gpu_type      = null

    // Two images, because they need opposite things and cannot be one: tiling
    // needs openslide and no TensorFlow, inference needs TensorFlow 2.2 with
    // CUDA and no openslide. Upstream pins tensorflow-gpu 2.2 / keras 2.4.3 /
    // h5py 2.10 (requirments.txt) and the checkpoint is a Keras .h5 that will
    // not load under an arbitrary newer TensorFlow.
    // Deliberately null: the CPU steps run natively, not in a container.
    // Everything they import — openslide, numpy, PIL, tifffile, scipy.io, cv2,
    // skimage, pandas — is already in the cluster conda env below, verified on
    // a compute node 2026-09-15, and Stage 1 of the HPL pipeline already tiles
    // whole slides that way with no container at all. One image for the one
    // step that needs CUDA is less to build, less to bind and less to drift.
    tiling_container = null

    // Prepended to PATH for every natively-run task. Not inherited: a Slurm
    // job's environment comes from whatever submitted it, and the chain here
    // is server -> head job -> task, any link of which may have been started
    // without this env active. CLAUDE.md's rule for the HPL container applies
    // just as well without one — assume nothing the job needs from the
    // submitting environment survives. Set to null to use whatever PATH the
    // task inherits.
    native_env_bin = '/hpc-home/home/users/vpandya/conda_envs/hpl_kb/bin'
    // Verified on this cluster 2026-09-15: loads AIgrading_anorak.h5 in 3.7s
    // under TensorFlow 2.11 / CUDA 12.1, and sees an A100 (compute 8.0). The
    // pinned tensorflow-gpu 2.2 in AIgrading/requirments.txt cannot — CUDA
    // 10.1 tops out at compute capability 7.5 — so this image is not a
    // convenience, it is the only way the model reaches a GPU here.
    gpu_container    = '/mnt/cephfs-lts/long-term-scratch/users/vpandya/Work/containers/tensorflow_23.03-tf2-py3.sif'

    // What that image does not have. It is an NGC *TensorFlow* image: it
    // carries TensorFlow, CUDA and numpy and nothing from upstream's
    // requirments.txt beyond them, so `import cv2` at the top of
    // inference_slide/predict_gp.py ends every GPU task in seconds with
    // ModuleNotFoundError. $HOME is not writable inside the image and pip
    // cannot reach the internet from a compute node, so the packages live in
    // a bound directory on scratch and reach the interpreter on PYTHONPATH —
    // the same arrangement, for the same reasons, as HPL_CONTAINER_EXTRAS in
    // backend/submit_feature_extraction.py.
    //
    // Build it with tools/bootstrap_gpu_extras.sh, which installs only the
    // modules the image is actually missing and with --no-deps, so nothing
    // here can shadow the image's own numpy or TensorFlow. Set to null to run
    // against an image that needs no extras.
    gpu_extras       = '/mnt/cephfs-lts/long-term-scratch/users/vpandya/Work/containers/anorak_gpu_extras'

    // Filesystem roots every container must be able to see. Both the symlink
    // side and its target — see the singularity block below for why binding
    // one is not enough. Same list as _CLUSTER_BIND_ROOTS in
    // backend/submit_feature_extraction.py; they are describing one cluster
    // and should not drift apart.
    bind_roots = ['/mnt/cephfs-lts', '/hpc-home']

    // What a retry may grow to (see nextflow.config). compute's MaxTime is
    // 2-00:00:00, the ceiling backend/submit_anorak_nf.py's head job is sized
    // against; gpu is uncapped in time, so 36 h is simply the third attempt's
    // request, written down so it cannot grow unnoticed. The memory ceilings
    // are likewise the third attempt's requests (stitch 72 GB, inference
    // 96 GB), not measured node sizes: tools/preflight.sh check 6 compares all
    // four against sinfo and fails if a partition has no node that large.
    // Lower one there rather than here if it does — a request no node can
    // satisfy pends forever while the head job looks healthy.
    max_cpu_memory = '72.GB'
    max_cpu_time   = '2d'
    max_gpu_memory = '96.GB'
    max_gpu_time   = '36h'

    // executor.queueSize, below. A param so it can be lowered per run
    // (--queue_size 150) without editing this file; CLI params are visible
    // here when the config is parsed (verified on 26.04.6).
    queue_size     = 200
}

// How many jobs Nextflow keeps in the queue at once. It belongs to the
// executor, not to `process`: as `process.queueSize` Nextflow warns
// "Unrecognized config option" and then ignores it, so the run gets the
// default rather than the limit asked for — a warning that scrolls past in a
// log full of other output, and a difference you would only notice as an
// unexpectedly large share of the partition.
//
// 200, up from 50. A tiling task takes ~10 min, so at 50 the tiling of a
// 7,221-slide cohort alone was ~24 h of wall clock; at 200 it is ~6 h if the
// partition has the room, and simply pends in Slurm if it does not. The GPU
// step is bounded by the 25 GPUs whatever this says.
//
// It must leave room under the per-user submit limit (MaxSubmitJobs /
// MaxSubmitPU, `sacctmgr show assoc user=$USER format=maxsubmit` and
// `sacctmgr show qos format=name,maxsubmitpu`): every job this user has
// queued counts, not only this run's, so the head job itself, any chain
// standby jobs backend/submit_anorak_nf.py has queued behind it, and
// queue_size together must stay below it. A refused sbatch fails the task,
// and after its retries the run finishes. tools/preflight.sh checks the sum.
//
// pollInterval 30 s rather than the grid default of a few seconds: every poll
// reads each running task's .exitcode off CephFS, and a read that lands in the
// millisecond window while another node is still writing that file is what
// blocked the task monitor forever on 2026-09-23. Fewer reads, fewer chances;
// 30 s of latency on a 10-minute task costs nothing.
//
// dumpInterval is pinned, not left to the default, because the head job's
// watchdog (tools/nf_supervise.sh) reads its absence as a stall: a healthy task
// monitor logs a summary this often while anything is running. Keep it well
// under ANORAK_WATCHDOG_STALL_SECONDS (30 min) in backend/submit_anorak_nf.py.
//
// exitReadTimeout 15 min, up from 270 s. It is how long Nextflow waits for a
// finished job's .exitcode to become readable before failing the task with
// Integer.MAX_VALUE, and on CephFS a file another node has just written can
// take longer than that to appear here. Each such failure is a retry of work
// that had succeeded — or, before nextflow.config retried MAX_VALUE, the end
// of the run. Keep it well under the watchdog's 30 minutes.
executor {
    queueSize       = params.queue_size
    pollInterval    = '30 sec'
    dumpInterval    = '5 min'
    exitReadTimeout = '15 min'
}

process {
    executor = 'slurm'
    // Node-local $TMPDIR for the steps whose writes are small and repeated:
    // ss1_stich rewrites its whole-slide PNG every 20 tiles, and PREDICT_GP
    // writes one small mask per tile. Tiling and publishing turn it off below.
    scratch  = true

    // beforeScript rather than a container for the three CPU labels. A closure
    // so params are settled before it is evaluated, and empty when
    // native_env_bin is unset so nothing is prepended blindly.
    withLabel: 'process_(tiling|stitch|light|publish)' {
        beforeScript = { params.native_env_bin ? "export PATH=${params.native_env_bin}:\$PATH" : '' }
    }

    withLabel: process_tiling {
        queue     = params.cpu_partition
        container = params.tiling_container
        // Straight to the work directory on CephFS. A slide's tiles are GBs,
        // and with scratch they sat in node-local $TMPDIR until the copy-back;
        // a few tiling tasks sharing a node could fill it, and every one of
        // them then failed with exit 1 — retried, onto the same busy node as
        // often as not. What scratch would buy is not having a failed
        // attempt's partial tiles in its work directory, and that is
        // harmless: Nextflow never reuses a failed task's directory, and a
        // retry starts in a new one. Nor does it cost CephFS anything extra:
        // the copy-back created the same files there anyway, after the
        // tiling, instead of during it.
        scratch   = false
    }
    // Hard links cannot be made from node-local disk into outdir, and this
    // writes nothing of its own; bin/publish_tree.py links from the real
    // path either way.
    withLabel: process_publish {
        queue     = params.cpu_partition
        container = params.tiling_container
        scratch   = false
    }
    withLabel: process_gpu {
        queue          = params.gpu_partition
        // A closure, not a plain ternary: config is parsed before a CLI
        // --gpu_type is merged into params, so an inline expression would read
        // the default here and quietly ignore the override. Closures are
        // evaluated per task, after params are settled.
        clusterOptions = { params.gpu_type ? "--gres=gpu:${params.gpu_type}:1" : '--gres=gpu:1' }
        container      = params.gpu_container
    }
    // Both native, for the same reason as tiling: cv2, skimage and pandas are
    // in the conda env, and borrowing the TensorFlow image for them would pull
    // a 9 GB CUDA container onto a CPU node to resize a PNG.
    withLabel: process_stitch {
        queue     = params.cpu_partition
        container = params.tiling_container
    }
    withLabel: process_light {
        queue     = params.cpu_partition
        container = params.tiling_container
    }
}

singularity {
    enabled    = true
    autoMounts = true

    // --nv for the GPU, and the two filesystem roots bound *both* ways.
    //
    // That second part is not belt-and-braces. On this cluster
    // /hpc-home/home/users/<user>/long-term-scratch is a symlink into
    // /mnt/cephfs-lts, and a symlink inside a container is just a string: it
    // resolves against the container's filesystem, where the target does not
    // exist unless something bound it. Binding only the /hpc-home side gives a
    // directory that lists perfectly from the login node and is absent inside
    // the job — a slide that is "sitting right there" and cannot be opened.
    // backend/submit_feature_extraction.py hit exactly this, reached the GPU,
    // registered an H200 and died on a `cd`; its _bind_args carries the same
    // rule and the same comment.
    //
    // autoMounts covers the work directory and $HOME; these cover the raw
    // slides, the AIgrading clone and the checkpoint, which live elsewhere.
    runOptions = "--nv ${params.bind_roots.collect { "--bind ${it}:${it}" }.join(' ')}"

    // Nextflow starts the container as `env - PATH=... singularity exec`, so
    // the container gets TMP, TMPDIR, the NXF_ variables and nothing else —
    // including not the CUDA_VISIBLE_DEVICES through which Slurm tells a
    // --gres=gpu:1 task which card is its own. Unless Slurm's ConstrainDevices
    // is on (cgroup.conf), nothing else enforces that, and every PREDICT_GP on
    // a node sees every card: TensorFlow reserves memory on all of them and
    // computes on GPU 0, and the second task on a node dies in
    // ResourceExhausted. Whether it is on here has not been verified —
    // tools/preflight.sh checks — and it does not change this setting: with
    // device cgroups the variable is merely redundant, and harmless.
    // Whitelisted, it arrives as
    // SINGULARITYENV_CUDA_VISIBLE_DEVICES. bin/anorak_predict.py refuses a
    // task that still sees more than one card, and preflight check 9c runs
    // the same launch on a real node. The HPL container's --cleanenv lesson
    // again (CLAUDE.md): assume nothing crosses unless it is named.
    envWhitelist = 'CUDA_VISIBLE_DEVICES'
}
