/*
 * Beatson HPC. Everything cluster-specific is here.
 *
 * No container directive anywhere. The tiling and packaging steps run natively
 * under the interpreter the tile server itself runs (params.python), which is
 * what the per-stage Slurm jobs already do. The two steps that need the NGC
 * TensorFlow image — extraction and assignment — build their own
 * `singularity exec` line in bin/hpl_extract.py and bin/hpl_assign.py from the same builders the
 * per-stage submitters use, with the bind-both-sides and --cleanenv rules
 * those carry. Letting Nextflow wrap them in a container as well would put a
 * second, differently-bound singularity around the first.
 */

params {
    // Where each label's jobs go. The submitter passes all of these from the
    // server's settings (HPL_GPU_PARTITION, HPL_MERGE_PARTITION, the run's own
    // partition), so these defaults matter only for a hand-run pipeline.
    cpu_partition    = null      // null: Slurm's default partition, as for tiling today
    gpu_partition    = 'gpu'
    assign_partition = 'gpu'     // HPL_MERGE_PARTITION's default
    // An exact GRES string, chosen at submission by select_gpu_gres() from what
    // sinfo says is free. Type names are cluster-specific and exact: a type that
    // does not exist here is inert, not approximate.
    gpu_gres         = 'gpu:1'
}

// Same reasoning, and the same numbers, as anorak-nf/conf/beatson.config.
//
// queueSize: how many jobs Nextflow keeps queued at once. Must stay within the
// QOS per-user submit limit (`sacctmgr show qos format=name,maxsubmitpu`) —
// a refused sbatch fails the task and ends the run.
//
// pollInterval 30 s: every poll reads each running task's .exitcode off
// CephFS, and one such read blocking in the kernel is what stalled an ANORAK
// run for five hours on 2026-09-23. Fewer reads, fewer chances.
//
// dumpInterval is pinned because the head job's watchdog
// (anorak-nf/tools/nf_supervise.sh) reads the task monitor's silence as a
// stall: a healthy monitor logs a summary this often while anything runs. Keep
// it well under HPL_NF_WATCHDOG_STALL_SECONDS (30 min).
// exitReadTimeout 15 min, up from 270 s: how long Nextflow waits for a
// finished job's .exitcode to become readable before failing the task with
// Integer.MAX_VALUE. On CephFS a file another node has just written can take
// longer than that to appear here. Kept well under the watchdog's 30 minutes
// (anorak-nf/tools/nf_supervise.sh), and matching anorak-nf/conf/beatson.config.
executor {
    queueSize       = 200
    pollInterval    = '30 sec'
    dumpInterval    = '5 min'
    exitReadTimeout = '15 min'
}

process {
    executor = 'slurm'

    withLabel: 'hpl_(tiling|package|light|mean)' {
        queue = { params.cpu_partition }
    }
    withLabel: hpl_gpu {
        queue          = { params.gpu_partition }
        // A closure, so a CLI --gpu_gres is read per task rather than the
        // default being baked in when the config is parsed.
        clusterOptions = { "--gres=${params.gpu_gres}" }
    }
    withLabel: hpl_assign {
        queue          = { params.assign_partition }
        clusterOptions = { params.assign_device == 'gpu' ? '--gres=gpu:1' : '' }
    }
}
