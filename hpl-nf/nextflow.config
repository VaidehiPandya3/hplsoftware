/*
 * Defaults for the HPL Stages 1-4 pipeline. Cluster-specific settings live in
 * conf/beatson.config (-profile beatson); nothing here names a partition.
 *
 * Resources mirror what the per-stage submitters ask Slurm for, so a stage
 * behaves the same whether it was clicked through or run from here. Where a
 * number is a walltime it is a params value, because it is capped by the
 * partition's MaxTime and has to be changeable without editing this file.
 */

manifest {
    name            = 'hpl-nf'
    description     = 'HPL tiling, packaging, feature extraction and cluster assignment for H&E WSIs'
    author          = 'Vaidehi Pandya'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '0.1.0'
}

params {
    max_tiling_forks = 10

    tiling_time      = '2d'      // submit_array's default
    package_cpus     = 8
    package_time     = '2d'      // submit_packaging_job: 4h and 24h both proved short
    extract_time     = '2d'      // the encoder has no resume; see submit_feature_extraction.py
    mean_time        = '8h'      // submit_cluster_assignment.MEAN_TIME_LIMIT
    assign_cpus      = 16
    assign_time      = '2d'
    assign_device    = 'cpu'     // resolved at submission by resolve_device(); cpu or gpu

    // Package without slides whose tiling fails for good (after retries, or a
    // refusal). Off by default: an .h5 missing slides is exactly what the
    // per-stage path's afterok existed to prevent. On, the failed slides are
    // left out by the tiling gate and named on the tiling step. Set per run
    // from run_config.json by the submitter, so a resume can switch it on.
    allow_incomplete = false

    // Only for -stub: how many shards the plan steps pretend to emit; 0 emits
    // "skip", the plan's answer for an output that already validates.
    stub_extract_shards = 1
    stub_assign_shards  = 1
}

process {
    // Exit 65 is a bin/ wrapper's refusal (hpl_common.REFUSAL_EXIT_CODE): that stage's
    // output is wrong, a retry reads the same bytes, and continuing would carry
    // it into the next stage — so the run finishes (running tasks drain,
    // nothing new is queued). Everything else is retried twice, then finishes.
    // The list this replaced retried only kill signals, and so finished on the
    // two failures this cluster produces most: Integer.MAX_VALUE, Nextflow's
    // code for a .exitcode it could not read (node loss, preemption, a refused
    // sbatch, CephFS slower than exitReadTimeout), and 1 (any uncaught Python
    // exception). anorak-nf/nextflow.config made the same change for the same
    // reason. 'finish', not 'terminate', once retries are spent: terminate
    // kills every running task.
    errorStrategy = { task.exitStatus == 65 ? 'finish'
                      : task.attempt <= 2 ? 'retry' : 'finish' }
    maxRetries    = 2

    // TILE alone may end in 'ignore', and only when the run allows it: every
    // other failure still stops the run.
    withName: TILE {
        errorStrategy = { task.exitStatus != 65 && task.attempt <= 2 ? 'retry'
                          : params.allow_incomplete ? 'ignore' : 'finish' }
    }
    withLabel: hpl_tiling {
        cpus   = 1                           // the tiler is single-threaded
        memory = { 24.GB * task.attempt }
        time   = { params.tiling_time }
    }
    withLabel: hpl_package {
        cpus   = { params.package_cpus }
        memory = { 32.GB * task.attempt }
        time   = { params.package_time }
    }
    withLabel: hpl_gpu {
        cpus   = 8
        memory = { 64.GB * task.attempt }
        time   = { params.extract_time }
    }
    withLabel: hpl_mean {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = { params.mean_time }
    }
    withLabel: hpl_assign {
        cpus   = { params.assign_cpus }
        memory = { 64.GB * task.attempt }
        time   = { params.assign_time }
    }
    withLabel: hpl_light {
        cpus   = 2
        memory = { 16.GB * task.attempt }
        time   = '4h'                        // the shard merges; submit_*'s MERGE_TIME_LIMIT
    }
}

profiles {
    standard { process.executor = 'local' }
    beatson  { includeConfig 'conf/beatson.config' }
    // Resource requests dropped to nothing: a stub run does no work, and the
    // real ones exceed what a laptop advertises.
    stub {
        process {
            executor = 'local'
            withLabel: 'hpl_.*' { cpus = 1; memory = 1.GB; time = 10.m }
        }
    }
}

// Provenance. The trace in particular is what answers "which task, which
// node, how long" for a run the UI started and nobody watched.
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";     overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html";      overwrite = true }
